# ---------- Core ----------
ENVIRONMENT=development
SIMULATION_MODE=true
LOG_LEVEL=INFO

# ---------- Database ----------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_password@localhost:5432/sentinel

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- OpenSearch ----------
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX_EVENTS=security-events

# ---------- Auth / JWT ----------
JWT_SECRET=change-me-in-production-32-byte-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Seed admin ----------
SEED_ADMIN_EMAIL=admin@sentinel.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------- LLM (Phase 5) ----------
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
