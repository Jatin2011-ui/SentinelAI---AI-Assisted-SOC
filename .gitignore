# =============================================================================
# Sentinel AI - .gitignore
# =============================================================================

# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version
Pipfile.lock

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
test-results/

# Linting & type checking
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# =============================================================================
# Node.js / Frontend (React + Vite + TypeScript)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/
.vite/

# TypeScript
*.tsbuildinfo

# =============================================================================
# Databases
# =============================================================================
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# =============================================================================
# ML / Data Science
# =============================================================================
# Trained model weights & checkpoints
ml/models/*.pkl
ml/models/*.h5
ml/models/*.pt
ml/models/*.pth
ml/models/*.onnx
ml/models/*.bin
ml/models/*.safetensors
ml/models/checkpoints/

# Datasets (raw / processed)
ml/datasets/*.csv
ml/datasets/*.json
ml/datasets/*.parquet
ml/datasets/*.npz
ml/datasets/*.npy
data/synthetic/
data/samples/

# Evaluation reports (auto-generated)
scripts/evaluation_report.json
ml/evaluation/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*.ipynb

# =============================================================================
# Docker
# =============================================================================
docker-volumes/

# =============================================================================
# Logs & Runtime
# =============================================================================
logs/
*.log
*.log.*
log/

# =============================================================================
# OS & Editor
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~

# =============================================================================
# Alembic
# =============================================================================
alembic/versions/__pycache__/

# =============================================================================
# Misc
# =============================================================================
*.bak
*.tmp
*.orig
.cache/
.temp/
tmp/
